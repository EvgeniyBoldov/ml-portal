# Release state belongs to the production GitLab repository.
# Copy this file to release.env there, set the internal GitLab Container Registry
# path, commit it, and never put credentials in this file.
IMAGE_REPOSITORY=ml-registry.example.local
APP_IMAGE_TAG=v0.1.0
BASE_IMAGE_TAG=base-1.0
BASE_INPUT_SHA=sha256:replace-after-first-release
SOURCE_SHA=replace-after-first-release
DB_REVISION=replace-after-first-release
